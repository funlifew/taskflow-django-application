# =========================================================
# TaskFlow development environment
# =========================================================

DJANGO_SETTINGS_MODULE=config.settings.development

# Optional local hosts
DEV_ALLOWED_HOSTS=

# ---------------------------------------------------------
# Redis
# ---------------------------------------------------------

DEV_USE_REDIS=False

REDIS_URL=redis://127.0.0.1:6379/1

ENABLE_REDISBOARD=False

# ---------------------------------------------------------
# Dashboard application caching
# ---------------------------------------------------------

DASHBOARD_CACHE_ENABLED=True

DASHBOARD_SUMMARY_CACHE_TTL=60

DASHBOARD_PROGRESS_CACHE_TTL=300

DASHBOARD_CACHE_LOCK_TTL=5

DASHBOARD_CACHE_WAIT_ATTEMPTS=4

DASHBOARD_CACHE_WAIT_INTERVAL=0.02