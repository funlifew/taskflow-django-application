# =========================================================
# TaskFlow production environment
# =========================================================

DJANGO_SETTINGS_MODULE=config.settings.production


# ---------------------------------------------------------
# Django
# ---------------------------------------------------------

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=CHANGE_ME

ALLOWED_HOSTS=taskflow.example.com,www.taskflow.example.com

CSRF_TRUSTED_ORIGINS=https://taskflow.example.com,https://www.taskflow.example.com


# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------

DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432

DB_CONN_MAX_AGE=60

# For a local PostgreSQL server:
DB_SSLMODE=prefer

# For a remote managed database,
# prefer:
# DB_SSLMODE=require


# ---------------------------------------------------------
# Redis
# ---------------------------------------------------------

REDIS_URL=redis://127.0.0.1:6379/1

CACHE_KEY_PREFIX=taskflow

CACHE_TIMEOUT=300


# ---------------------------------------------------------
# SMTP
# ---------------------------------------------------------

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587

EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME

EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

DEFAULT_FROM_EMAIL="TaskFlow <noreply@example.com>"
SERVER_EMAIL="TaskFlow Server <server@example.com>"

EMAIL_TIMEOUT=10


# ---------------------------------------------------------
# HTTPS
# ---------------------------------------------------------

SECURE_SSL_REDIRECT=True

# Set True only when Django is reachable
# exclusively through your trusted reverse proxy.
TRUST_PROXY_SSL_HEADER=True


# ---------------------------------------------------------
# HSTS
# ---------------------------------------------------------

# Start with a short value such as 3600
# during the first verified HTTPS deployment.
#
# Once HTTPS is confirmed stable, increase to:
# 31536000

SECURE_HSTS_SECONDS=3600

SECURE_HSTS_INCLUDE_SUBDOMAINS=False

SECURE_HSTS_PRELOAD=False


# ---------------------------------------------------------
# Logging
# ---------------------------------------------------------

DJANGO_LOG_LEVEL=INFO

APP_LOG_LEVEL=INFO

GUNICORN_LOG_LEVEL=info


# ---------------------------------------------------------
# Gunicorn
# ---------------------------------------------------------

GUNICORN_BIND=127.0.0.1:8000

GUNICORN_WORKERS=2

GUNICORN_TIMEOUT=30

GUNICORN_GRACEFUL_TIMEOUT=30

GUNICORN_KEEPALIVE=5

GUNICORN_MAX_REQUESTS=1000

GUNICORN_MAX_REQUESTS_JITTER=100

GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# ---------------------------------------------------------
# Dashboard application caching
# ---------------------------------------------------------

DASHBOARD_CACHE_ENABLED=True

# Time-sensitive counts such as overdue
# and due-soon tasks.
DASHBOARD_SUMMARY_CACHE_TTL=60

# Status/progress aggregates use explicit
# invalidation and can live longer.
DASHBOARD_PROGRESS_CACHE_TTL=300

DASHBOARD_CACHE_LOCK_TTL=5

DASHBOARD_CACHE_WAIT_ATTEMPTS=4

DASHBOARD_CACHE_WAIT_INTERVAL=0.02